# Copy to .env and set every value. .env is not committed.

# The TessariDB store's owner, declared on its first start. Used only to declare the
# vault's own account; the vault never signs in as it.
TESSARIDB_USER=owner
TESSARIDB_PASSWORD=

# The vault's database account, an editor of the `vault` namespace only.
# At least 16 characters, no quote or backslash.
VAULT_STORE_PASSWORD=

# The first person to sign in: the platform admin, who creates companies.
PLATFORM_ADMIN_EMAIL=ops@example.com
PLATFORM_ADMIN_NAME=Platform Ops

# Where people reach the vault: https in production, http://localhost for a trial.
VAULT_PUBLIC_URL=http://localhost:8080
VAULT_PORT=8080
